# finance-quant Polygon.io configuration
# Copy this file to .env and fill in your real key. NEVER commit .env.
# .env is already in .gitignore; this .env.example is committed for documentation only.

# --- Required: Polygon.io API key -------------------------------------------
# Get one at https://polygon.io/dashboard/api-keys
# Free tier is sufficient for end-of-day bars and corporate actions.
POLYGON_API_KEY=

# --- Optional: HTTP overrides ----------------------------------------------
# Override only if you proxy Polygon through a sandbox/mock server.
# POLYGON_BASE_URL=https://api.polygon.io

# HTTP timeout in seconds for the default transport.
# (Not read from env today; the PolygonConfig dataclass default is 30s.)

# --- Optional: rate-limit knobs --------------------------------------------
# Steady-state requests per second. Polygon free tier: 5/s. Paid plans are higher.
# POLYGON_RPS=5

# Number of retry attempts on HTTP 429 (Too Many Requests) responses.
# POLYGON_MAX_RETRIES=3
